# Copy this file to .env and adjust.

# Web server
PORT=3000
# Keep 127.0.0.1 so only your own PC can reach the app.
HOST=127.0.0.1

# PostgreSQL connection (same details you use in pgAdmin / DBeaver)
PGHOST=localhost
PGPORT=5432
PGDATABASE=taskmgr
PGUSER=postgres
PGPASSWORD=postgres

# Backups
BACKUP_DIR=./backups
# Hours between automatic backups (a backup is also taken at startup if the last one is older than this)
BACKUP_INTERVAL_HOURS=24
# How many backups of each kind to keep
BACKUP_KEEP=30
# Optional: full path to pg_dump for native PostgreSQL dumps in addition to JSON backups.
# pgAdmin ships one, e.g. C:\Program Files\pgAdmin 4\runtime\pg_dump.exe
# Leave blank to auto-detect pg_dump on PATH (JSON backups always run regardless).
PG_DUMP_PATH=

# Logs
LOG_DIR=./logs
