# Optional: copy this file to .env to change any of these settings.

# Web server
PORT=3000
# Keep 127.0.0.1 so only your own PC can reach the app.
HOST=127.0.0.1

# Where your data lives. By default it's OUTSIDE the app folder, so updates
# can never touch it:  %LOCALAPPDATA%\CIManager  (C:\Users\<you>\AppData\Local\CIManager)
# The database (taskmgr.db), backups and logs all go there. Uncomment to move it.
# Don't use a OneDrive-synced folder for the live database.
#DATA_DIR=C:\CIManagerData

# Optional overrides for individual locations (default: inside DATA_DIR)
#DB_FILE=
# A OneDrive or network folder is a good choice for backups
#BACKUP_DIR=

# Hours between automatic backups (a backup is also taken at start-up if the last one is older than this). 0 = off.
BACKUP_INTERVAL_HOURS=24
# How many backups of each kind to keep
BACKUP_KEEP=30

# Logs (default: inside DATA_DIR)
#LOG_DIR=

# Shared defaults: a cimanager-defaults.json with the network file paths everyone uses
# (exported on KPIs > Sources > Shared paths), read each time the app starts. Fills in only
# paths that are blank or still as the file last set them. CIManager-Setup.bat sets this
# when the file is next to it. Default: cimanager-defaults.json in the folder above the app.
#DEFAULTS_FILE=\\server\share\CI Manager\cimanager-defaults.json

# Each start from the CI Manager shortcut checks GitHub for a newer version and updates first
# (CIManager-Setup.bat, in a window). 0 = never check; update by running CIManager-Setup.bat.
#AUTO_UPDATE=0
